{
  "name": "praxis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:backend": "pnpm --filter @praxis/api test",
    "test:frontend": "pnpm --filter @praxis/web test"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^5"
  }
}

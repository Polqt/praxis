# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection URL (used by the API at runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Direct connection URL (used by migrations and seed scripts)
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase JWKS endpoint used to verify JWTs — found in Supabase dashboard > Settings > API
SUPABASE_JWKS_URL=https://your-project.supabase.co/.well-known/jwks.json

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-GCM key for encrypting stored GitHub tokens. Must be a base64-encoded 32-byte value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API Server ────────────────────────────────────────────────────────────────
# Allowed CORS origin for the web app — required, no default, startup will fail without it
CORS_ORIGIN=http://localhost:3000

PORT=4000

NODE_ENV=development

# ── Ingestion limits ──────────────────────────────────────────────────────────
INGESTION_MAX_TREE_FILES=500
INGESTION_MAX_SELECTED_FILES=80
INGESTION_MAX_FILE_BYTES=102400
INGESTION_MAX_TOTAL_BYTES=1048576

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_HEARTBEAT_KEY=praxis:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=30

# ── Submission limits ─────────────────────────────────────────────────────────
# Number of hours before an in-progress submission is marked expired
SUBMISSION_EXPIRY_HOURS=6

# Maximum number of submissions a user can create per hour
SUBMISSION_RATE_LIMIT_PER_HOUR=5
